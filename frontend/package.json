{
  "name": "sutech-transport-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/sw/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "openapi": "tsx scripts/generate-openapi.ts",
    "tokens": "tsx scripts/generate-tokens.ts",
    "road-paths": "tsx scripts/generate-road-paths.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run test",
    "knip": "knip --no-progress"
  },
  "dependencies": {
    "@serwist/turbopack": "^9.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "knip": "^5.88.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "zod": "$zod",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.16.13": true,
    "@swc/core@1.16.21": true,
    "@parcel/watcher@2.6.0": true
  }
}
