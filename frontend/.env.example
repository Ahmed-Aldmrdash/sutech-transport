# Required for every production build (`npm run build`): the build stops if it is missing.
# "mock" runs the whole app on the in-browser mock server (no backend needed, demo accounts).
# "live" sends every request to the FastAPI server below.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Live mode: where uploaded files (receipts, documents, photos) are served from, when not from
# the API itself (e.g. a storage bucket's signed links). Comma-separated origins. The page's
# Content-Security-Policy lets images load from the API and from these.
NEXT_PUBLIC_FILE_ORIGINS=
# Artificial delay for mock responses, in milliseconds (makes loading states visible).
NEXT_PUBLIC_MOCK_LATENCY_MS=150
# Developer pages (/ar/ui and /ar/preview/<role>). Left empty: on in `npm run dev`, off in a
# build. "true" turns them on in a mock build too (never for a demo others can open). Never
# available in live mode.
NEXT_PUBLIC_DEV_PAGES=
# Map tiles. Required in a live build: the university's contracted (or self-hosted) provider.
# Left empty, mock and dev builds use openstreetmap.org, which is not allowed in production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
